@baseUrl = https://localhost:44376
@token = {{$dotenv JWT_TOKEN}}
@pasienId = 517102000000046
@userId = USER-001

### 1. Register Pasien Reguler Dewasa (Usia >= 17 Tahun dengan NIK)
POST {{baseUrl}}/api/Pasien
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "pasienName": "Agus Budiono",
  "tempatLahir": "Surabaya",
  "tglLahir": "1990-05-15",
  "gender": "L",
  "nickName": "Agus",
  "ibuKandung": "Siti Aminah",
  "golDarah": "O",
  "alamat1": "Jl. Basuki Rahmat No. 12",
  "alamat2": "RT 01 / RW 02",
  "alamat3": "Genteng",
  "kota": "Surabaya",
  "kodePos": "60271",
  "noTelp": "081234567890",
  "noKtp": "3578011505900001"
}

### 2. Register Pasien Anak (Usia < 17 Tahun Tanpa NIK)
POST {{baseUrl}}/api/Pasien
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "pasienName": "Ananda Putra",
  "tempatLahir": "Surabaya",
  "tglLahir": "2020-08-17",
  "gender": "L",
  "nickName": "Nanda",
  "ibuKandung": "Siti Aminah",
  "golDarah": "O",
  "alamat1": "Jl. Basuki Rahmat No. 12",
  "alamat2": "RT 01 / RW 02",
  "alamat3": "Genteng",
  "kota": "Surabaya",
  "kodePos": "60271",
  "noTelp": "081234567890",
  "noKtp": ""
}

### 3. Register Pasien Baru Berbasis e-KTP
POST {{baseUrl}}/api/Pasien/createByKtp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "pasienName": "Dewi Sartika",
  "nik": "3578015010920002",
  "alamatKtp": "Jl. Pemuda No. 45",
  "golDarah": "A",
  "gender": "P",
  "tempatLahir": "Surabaya",
  "tglLahir": "1992-10-10",
  "agama": "Islam",
  "statusKawin": "Kawin",
  "kotaKtp": "Surabaya",
  "kodePosKtp": "60271",
  "rt": "03",
  "rw": "04",
  "kelurahanKtpId": "0010010101"
}

### 4. Get Detail Data Sosial Pasien by ID
GET {{baseUrl}}/api/Pasien/{{pasienId}}
Authorization: Bearer {{token}}
Accept: application/json

### 5. Search Pasien Aktif by Keyword (No RM / NIK / Nama / No Telp)
GET {{baseUrl}}/api/Pasien/search/Agus
Authorization: Bearer {{token}}
Accept: application/json

### 6. Patch KTP Pasien (dengan UserId)
PATCH {{baseUrl}}/api/Pasien/ktp
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "pasienId": "{{pasienId}}",
  "pasienName": "Agus Budiono",
  "nik": "3578011505900001",
  "alamatKtp": "Jl. Basuki Rahmat No. 12",
  "golDarah": "O",
  "gender": "L",
  "tempatLahir": "Surabaya",
  "tglLahir": "1990-05-15",
  "agama": "Islam",
  "statusKawin": "Kawin",
  "rt": "01",
  "rw": "02",
  "kelurahanKtpId": "0010010101",
  "isForceUpdate": false,
  "userId": "{{userId}}"
}

### 7. Patch Demografi & Status Sosial Pasien (dengan UserId)
PATCH {{baseUrl}}/api/Pasien/demografi
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "pasienId": "{{pasienId}}",
  "statusKawinId": "2",
  "agamaId": "1",
  "sukuId": "001",
  "pekerjaanId": "001",
  "pendidikanId": "001",
  "alamatDomisili1": "Jl. Gubeng Pojok No. 5",
  "alamatDomisili2": "RT 02 / RW 03",
  "alamatDomisili3": "Genteng",
  "kelurahanId": "0010010101",
  "kotaDomisili": "Surabaya",
  "kodePosDomisili": "60272",
  "noKartuKeluarga": "3578011505900002",
  "email": "agus.budiono@example.com",
  "noHp": "081234567890",
  "namaKeluarga": "Siti Aminah",
  "relasi": "Istri",
  "noTelpKeluarga": "081234567899",
  "alamat1Keluarga": "Jl. Gubeng Pojok No. 5",
  "alamat2Keluarga": "RT 02 / RW 03",
  "kotaKeluarga": "Surabaya",
  "kodePosKeluarga": "60272",
  "ibuKandung": "Wati Sukeni",
  "userId": "{{userId}}"
}

### 8. Patch Tambah / Update Kontak Pasien (dengan UserId)
PATCH {{baseUrl}}/api/Pasien/addContact
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "pasienId": "{{pasienId}}",
  "jenisContact": 2,
  "detilContact": "081298765432",
  "userId": "{{userId}}"
}

### 9. Patch Non-Active Pasien (Deaktivasi dengan UserId)
PATCH {{baseUrl}}/api/Pasien/nonActive
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "pasienId": "{{pasienId}}",
  "userId": "{{userId}}"
}

### 10. Patch Re-Active Pasien (Reaktivasi dengan UserId)
PATCH {{baseUrl}}/api/Pasien/reActive
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "pasienId": "{{pasienId}}",
  "userId": "{{userId}}"
}

### 11. Patch Persetujuan Upload SATUSEHAT
PATCH {{baseUrl}}/api/Pasien/approveUploadSaset
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "pasienId": "{{pasienId}}"
}
