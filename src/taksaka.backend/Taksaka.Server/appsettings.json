{
  "Database": {
    "Provider": "SQLite",
    "ConnectionString": "Data Source=taksaka.db"
  },
  "PluginLoader": {
    "PluginsPath": "./plugins"
  },
  "Engine": {
    "DispatchPollIntervalSeconds": 2,
    "HealthMonitorIntervalSeconds": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:8081"
    ]
  }
}
