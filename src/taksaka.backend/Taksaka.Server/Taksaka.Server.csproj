<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Taksaka.Engine\Taksaka.Engine.csproj" />
    <ProjectReference Include="..\Taksaka.Infrastructure\Taksaka.Infrastructure.csproj" />
    <ProjectReference Include="..\Taksaka.Workers.Projection\Taksaka.Workers.Projection.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Taksaka.Workers.Integration\Taksaka.Workers.Integration.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyPlugins" AfterTargets="Build">
    <PropertyGroup>
      <PluginsOutputPath>$(OutputPath)plugins</PluginsOutputPath>
    </PropertyGroup>
    <MakeDir Directories="$(PluginsOutputPath)" />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\..\Taksaka.Workers.Projection\bin\$(Configuration)\$(TargetFramework)\Taksaka.Workers.Projection.dll"
      DestinationFolder="$(PluginsOutputPath)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)\..\Taksaka.Workers.Integration\bin\$(Configuration)\$(TargetFramework)\Taksaka.Workers.Integration.dll"
      DestinationFolder="$(PluginsOutputPath)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
